# vibe-security-score — production environment.
# Copy to /etc/vibe-grader.env (chmod 600, owner = the service user) and edit.
# systemd loads this via EnvironmentFile for both services (web + worker).
#
# SECURITY: never put OPENAI_API_KEY / CODEX_API_KEY here. Code generation uses
# the operator's ChatGPT login only; the runner blanks those vars to prevent
# paid API billing.

# --- Django core ---
DJANGO_SECRET_KEY=CHANGE-ME-generate-a-50+char-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=grader.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://grader.example.com
DJANGO_STATIC_ROOT=/opt/vibe-security-score/grader/staticfiles
DJANGO_TIME_ZONE=Asia/Seoul
# HSTS max-age defaults to 1 year. Enable preload only once every subdomain is
# HTTPS (it is a semi-irreversible commitment): DJANGO_HSTS_PRELOAD=1
# DJANGO_HSTS_PRELOAD=0

# --- Database (PostgreSQL recommended for parallel scoring writes) ---
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=vibe_grader
DJANGO_DB_USER=vibe
DJANGO_DB_PASSWORD=CHANGE-ME
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432

# --- Gunicorn (web) ---
GRADER_DIR=/opt/vibe-security-score/grader
GUNICORN_BIND=127.0.0.1:8001
# GUNICORN_WORKERS=3

# --- Codex (generation) ---
# Where the operator's `codex login` credentials live (auth.json). The worker
# runs `codex exec` using this session. Keep it readable only by the service user.
CODEX_HOME=/opt/vibe-security-score/.codex
