# Booth VM: copy to /etc/vibe-grader.env (root, chmod 600) and set the key:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Both vibe-web and vibe-worker read it. Never commit the real key.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=CHANGE-ME
DJANGO_ALLOWED_HOSTS=bcsc.aps.or.kr,192.168.2.214,localhost,127.0.0.1
# HTTPS ends at another server's nginx, which proxies here with the Host kept and
# no X-Forwarded-Proto: the https origin must be trusted for POSTs to pass the
# CSRF origin check, and Django's own HTTPS redirect would loop, so it is off.
DJANGO_CSRF_TRUSTED_ORIGINS=https://bcsc.aps.or.kr
DJANGO_SECURE_SSL_REDIRECT=0
